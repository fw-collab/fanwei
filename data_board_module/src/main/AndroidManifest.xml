<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".BoardMainActivity"
            android:exported="true"
            android:icon="@drawable/ic_board"
            android:label="@string/board_title"
            android:launchMode="singleTop"
            android:taskAffinity="com.example.wordmemory.board"
            android:theme="@style/Theme.WordMemory.Board">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android 9 及以下的导出文件通过 FileProvider 共享；Android 10+ 使用 MediaStore -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.board.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/board_file_paths" />
        </provider>
    </application>

</manifest>
